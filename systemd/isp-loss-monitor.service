[Unit]
Description=Uplink Ledger Internet-path quality monitor
Documentation=file:///opt/isp-loss-monitor/README.md
Documentation=file:///opt/isp-loss-monitor/docs/README.md
Documentation=https://github.com/jodytripp/uplink-ledger
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=ispmon
Group=ispmon
WorkingDirectory=/var/lib/isp-loss-monitor
EnvironmentFile=/etc/sysconfig/isp-loss-monitor
ExecStart=/usr/bin/python3 /opt/isp-loss-monitor/isp_loss_monitor.py $ISPMON_ARGS
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0027

AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/isp-loss-monitor

[Install]
WantedBy=multi-user.target
