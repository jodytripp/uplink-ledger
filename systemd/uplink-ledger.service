[Unit]
Description=Uplink Ledger Internet-path quality monitor
Documentation=file:///opt/uplink-ledger/README.md
Documentation=file:///opt/uplink-ledger/docs/README.md
Documentation=https://github.com/jodytripp/uplink-ledger
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=uplinkledger
Group=uplinkledger
WorkingDirectory=/var/lib/uplink-ledger
EnvironmentFile=/etc/sysconfig/uplink-ledger
ExecStart=/usr/bin/python3 /opt/uplink-ledger/uplink_ledger.py $UPLINK_LEDGER_ARGS
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0027

AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/uplink-ledger

[Install]
WantedBy=multi-user.target
